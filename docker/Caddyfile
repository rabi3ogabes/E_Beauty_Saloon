# Caddy terminates TLS for the platform domain, *.base subdomains and every verified custom domain.
# On-demand TLS asks the app before issuing a certificate (GET /internal/caddy/ask?domain=...).
{
    email {$ACME_EMAIL}
    on_demand_tls {
        ask http://app-web/internal/caddy/ask
    }
}

https:// {
    tls {
        on_demand
    }
    encode zstd gzip
    root * /var/www/html/public
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
    @static path /build/* /css/* /js/* /fonts/* /storage/*
    header @static Cache-Control "public, max-age=31536000, immutable"
    php_fastcgi app:9000
    file_server
}
